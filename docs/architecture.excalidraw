    {
      "type": "text",
      "id": "ev_perm_code",
      "x": 1255,
      "y": 1010,
      "width": 445,
      "height": 175,
      "text": "// 1. 危险工具拦截交互\n[permission] Approve shell? [y/N]: N\n[tool_result] shell -> { ok: false, output: \"denied\" }\n\n// 2. 并发组与顺序 Barrier 调度时序\nCalls: [read_a, read_b, write_c, read_d]\n  ├── Group 1 (Parallel): Promise.all([read_a, read_b])\n  ├── Barrier (Exclusive): await write_c (安全审批)\n  └── Group 2 (Parallel): Promise.all([read_d])\nCommit Order: [res_a, res_b, res_c, res_d] (严格原序)",
      "originalText": "// 1. 危险工具拦截交互\n[permission] Approve shell? [y/N]: N\n[tool_result] shell -> { ok: false, output: \"denied\" }\n\n// 2. 并发组与顺序 Barrier 调度时序\nCalls: [read_a, read_b, write_c, read_d]\n  ├── Group 1 (Parallel): Promise.all([read_a, read_b])\n  ├── Barrier (Exclusive): await write_c (安全审批)\n  └── Group 2 (Parallel): Promise.all([read_d])\nCommit Order: [res_a, res_b, res_c, res_d] (严格原序)",
      "fontSize": 12,
