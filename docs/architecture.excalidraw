      "x": 1255,
      "y": 350,
      "width": 445,
      "height": 250,
      "text": "// 1. 模型发起的工具调用\n{\n  \"role\": \"assistant\",\n  \"tool_calls\": [\n    {\n      \"id\": \"call_9f8a\",\n      \"type\": \"function\",\n      \"function\": {\n        \"name\": \"read_file\",\n        \"arguments\": \"{\\\"path\\\": \\\"README.md\\\"}\"\n      }\n    }\n  ]\n}\n// 2. 运行时回灌对应事实 (tool_call_id 严防错配)\n{\n  \"role\": \"tool\",\n  \"tool_call_id\": \"call_9f8a\",\n  \"content\": \"{\\\"ok\\\":true,\\\"output\\\":\\\"# Project...\\\"}\"\n}",
      "originalText": "// 1. 模型发起的工具调用\n{\n  \"role\": \"assistant\",\n  \"tool_calls\": [\n    {\n      \"id\": \"call_9f8a\",\n      \"type\": \"function\",\n      \"function\": {\n        \"name\": \"read_file\",\n        \"arguments\": \"{\\\"path\\\": \\\"README.md\\\"}\"\n      }\n    }\n  ]\n}\n// 2. 运行时回灌对应事实 (tool_call_id 严防错配)\n{\n  \"role\": \"tool\",\n  \"tool_call_id\": \"call_9f8a\",\n  \"content\": \"{\\\"ok\\\":true,\\\"output\\\":\\\"# Project...\\\"}\"\n}",
