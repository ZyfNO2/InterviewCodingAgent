  "cards": [
    {
      "dot": "cyan",
      "title": "控制与调度策略",
      "items": [
        "AgentLoop 承担步数保护 (maxSteps) 与多轮状态推进",
        "遵循 OpenAI 协议标准 assistant.tool_calls 与结构化回灌"
      ]
    },
    {
      "dot": "emerald",
      "title": "DSH 工程化解耦",
